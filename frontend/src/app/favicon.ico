<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <linearGradient id="saffronGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF9933" />
      <stop offset="100%" stop-color="#CC5500" />
    </linearGradient>
  </defs>

  <!-- Hexagon Frame with Open Gap / Sync Lines -->
  <path d="M 250 80 
           L 380 155 
           L 380 230 
           M 380 290 
           L 380 345 
           L 250 420 
           L 120 345 
           L 120 155 
           Z" 
        fill="none" 
        stroke="url(#saffronGradient)" 
        stroke-width="22" 
        stroke-linecap="round" 
        stroke-linejoin="round" />

  <!-- Central Connecting Bridge -->
  <path d="M 160 250 L 340 250" 
        fill="none" 
        stroke="url(#saffronGradient)" 
        stroke-width="20" 
        stroke-linecap="round" />

  <!-- Central Core Node -->
  <circle cx="250" cy="250" r="45" fill="url(#saffronGradient)" />
</svg>
